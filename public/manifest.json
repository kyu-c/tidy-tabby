{
  "manifest_version": 3,
  "name": "TidyTabby",
  "version": "0.4.0",
  "description": "TidyTabby keeps tab clutter under control by automatically closing inactive tabs",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
