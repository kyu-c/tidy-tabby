{
  "manifest_version": 3,
  "name": "TidyTabby",
  "version": "0.0.1",
  "description": "A Chrome extension to tidy up your tabs!",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
